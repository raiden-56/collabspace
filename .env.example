# ---- Database ----
DATABASE_URL=postgresql://collabspace:collabspace@localhost:5434/collabspace?schema=public

# ---- Redis (optional; enables cross-instance realtime fan-out + distributed rate limits) ----
REDIS_URL=redis://localhost:6380

# ---- Sessions / security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# ---- Public URLs ----
APP_URL=http://localhost:3000
API_URL=http://localhost:4100
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:4101
# Trusted origins for CSRF/WebSocket origin checks (comma separated)
TRUSTED_ORIGINS=http://localhost:3000

# ---- Ports ----
API_PORT=4100
SYNC_PORT=4101
# Shared secret used by the API to push events into the sync service
INTERNAL_EVENT_SECRET=change-me-internal

# ---- Object storage (S3 compatible). Leave STORAGE_DRIVER=local to store files on disk. ----
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=collabspace
S3_ACCESS_KEY=collabspace
S3_SECRET_KEY=collabspace123
S3_FORCE_PATH_STYLE=true
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

# ---- Email: log (print to API log, default for dev) | smtp | disabled. Mailpit: docker compose --profile mail up -d ----
EMAIL_DRIVER=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="CollabSpace <no-reply@collabspace.local>"

# ---- AI provider ----
# AI_PROVIDER: anthropic | mock | disabled
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_INPUT_CHARS=120000

# ---- Misc ----
LOG_LEVEL=info
NODE_ENV=development
SYNC_URL=http://localhost:4101
